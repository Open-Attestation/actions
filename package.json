{
  "name": "svelte-app",
  "version": "1.0.0",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "integration": "testcafe chrome integration/**/*.ts",
    "integration:headless": "testcafe chrome:headless integration/**/*.ts --app \"serve ./public --listen 5000 --single\" --app-init-delay 5000",
    "start": "sirv public"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^11.0.0",
    "@rollup/plugin-node-resolve": "^7.0.0",
    "prettier": "^3.5.1",
    "prettier-plugin-svelte": "^3.2.0",
    "rollup": "^2.79.2",
    "rollup-plugin-livereload": "^1.0.0",
    "rollup-plugin-svelte": "^5.0.3",
    "rollup-plugin-terser": "^5.1.2",
    "serve": "^12.0.0",
    "svelte": "^4.2.19",
    "testcafe": "^1.14.2"
  },
  "dependencies": {
    "query-string": "^6.10.1",
    "sirv-cli": "^0.4.4",
    "url-parse": "^1.4.7"
  },
  "overrides": {
    "jsonwebtoken": "^9.0.0",
    "cross-spawn": "7.0.5",
    "minimatch": "^3.0.5",
    "path-to-regexp": "^3.3.0"
  },
  "prettier": {
    "printWidth": 120
  }
}
